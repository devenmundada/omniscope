# ==============================================================================
# OmniScope — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Never commit .env.local or any real credentials to version control.
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Production Application Base URL (Optional: used to resolve reverse-proxy callbacks)
# APP_URL="https://your-domain.vercel.app"

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection (STRICTLY SERVER-SIDE - Drizzle ORM)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For Supabase: paste the Session Pooler URL (port 5432, IPv4 compatible). The app and build scripts
# connect through the Transaction Pooler (port 6543, same credentials) automatically, which serverless needs.
# WARNING: NEVER prefix with NEXT_PUBLIC_
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Supabase Authentication (Browser & Server SSR Integration)
# ------------------------------------------------------------------------------
# Browser-safe public credentials (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# ------------------------------------------------------------------------------
# Market Data Providers (STRICTLY SERVER-SIDE)
# ------------------------------------------------------------------------------
# Twelve Data API key for Indian Equity and ETF End-of-Day quotes
# AMFI mutual fund NAVs sync automatically from official daily public feed without an API key.
# WARNING: NEVER prefix with NEXT_PUBLIC_
MARKET_DATA_API_KEY=""

# ------------------------------------------------------------------------------
# Scheduled Job Protection (STRICTLY SERVER-SIDE)
# ------------------------------------------------------------------------------
# Secret token required to trigger /api/cron/sync-prices via Bearer header
# WARNING: NEVER prefix with NEXT_PUBLIC_
CRON_SECRET=""
